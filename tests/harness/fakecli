#!/bin/bash
# Fake xcoin-wallet-cli for the MMM harness: no card reader, no network, no real wallet.
# Its output has the real CLI's shapes (wallet_cli.py), so MMM is tested against what it will read.
echo "$*" >> "$FAKE_DIR/calls.log"
read -r pw
args=" $* "
ev() { echo "XCOIN-EVENT $*" >&2; }
# a wait that CANCEL's SIGTERM ends at once, and whose sleep never holds MMM's pipes open
hold() { sleep "$1" >/dev/null 2>&1 </dev/null & kid=$!; wait $kid; }
# a CANCEL (or quit, or timeout) whose SIGTERM crossed card-provisioning: the line was already on its way.
# Armed before the first event, so no SIGTERM can come before it.
case "$FAKE_MODE" in
 crossterm|newcross) trap 'kill $kid 2>/dev/null; ev card-provisioning; trap - TERM; kill -TERM $$' TERM;;         # died in the CLI's pause: nothing written
 crosskill) trap 'kill $kid 2>/dev/null; ev card-provisioning; trap "" TERM; sleep 2 >/dev/null 2>&1' TERM;;       # past the pause: SIGTERM ignored mid-write (MMM spares it: no SIGKILL), the write goes on
 commitcross) trap 'kill $kid 2>/dev/null; ev card-provisioning; trap "" TERM; sleep 6 >/dev/null 2>&1; echo "{\"ok\": true}"; exit 0' TERM;;   # the same past a timeout's 5 s grace, then it ends by itself
 stubborn) trap '' TERM;;                                                                                          # ignores SIGTERM with nothing committed: SIGKILL still ends it
esac
case "$args" in
 *" card-status "*) n=$(cat "$FAKE_DIR/cards" 2>/dev/null || echo 1)
   printf '{"card": true, "format": "mmm2", "family": "fam1", "cards": [{"uid": "04AA", "label": "primary", "permanent": true, "created": "2026-09-24"}], "count": %s, "backup_supported": true, "note": "x"}\n' "$n";;
 *" card-backup "*)
   [[ "$args" == *" --auto-swap "* ]] || { echo "error: no --auto-swap" >&2; exit 2; }
   echo $$ > "$FAKE_DIR/pid"; rm -f "$FAKE_DIR/written"
   ev card-wait 60; sleep 0.2; ev card-ok; ev card-swap; sleep 0.2; ev card-removed; ev card-wait 45
   [ "$FAKE_MODE" = slowblank ] && hold 30
   [[ "$FAKE_MODE" == cross* ]] && hold 30
   ev card-provisioning
   [ "$FAKE_MODE" = slowwrite ] && sleep 2
   [ "$FAKE_MODE" = selfkill ] && { sleep 0.3; kill -KILL $$; }                                                      # SIGKILLed mid-write (a crash, or the backstop)
   if [ "$FAKE_MODE" = failwrite ]; then echo "error: writing the backup card did not finish (the card stopped answering). Do not rely on that card: make another backup with a fresh blank card." >&2; exit 1; fi
   if [ "$FAKE_MODE" = failwrite-old ]; then echo "error: the new card stopped answering" >&2; exit 1; fi   # a CLI that does not say it
   touch "$FAKE_DIR/written"; n=$(( $(cat "$FAKE_DIR/cards" 2>/dev/null || echo 1) + 1 )); echo $n > "$FAKE_DIR/cards"
   ev card-ok; printf '{"ok": true, "card_uid": "04BB", "family": "fam1", "permanent": true, "cards": %s}\n' "$n"; ev done;;
 *" new "*)   # new --card: the new card's wait, then its write
   [[ "$args" == *" --card "* && "$args" == *" --offline "* && "$args" == *" --json "* ]] || { echo "error: wrong new call" >&2; exit 2; }
   file=$(sed -E 's/.* --file ([^ ]+) .*/\1/' <<< "$args"); keys="$HOME/.xcoin"
   echo $$ > "$FAKE_DIR/pid"
   ev card-wait 60
   case "$FAKE_MODE" in
    newwait) hold 30;;                                                   # stopped while it waits for the card
    newhalf) sleep 0.2; touch "$keys/card-04CD.auth"; hold 30;;         # a CLI with no card-provisioning, stopped mid-write: its key file was saved
    newcross) hold 30;;
    newprov|newprovfail|newprovold|newfile)
      sleep 0.2; ev card-provisioning; sleep 1.5
      [ "$FAKE_MODE" = newprovfail ] && { echo "error: setting up the new card did not finish (the card stopped answering), so no wallet was created. Do not rely on that card." >&2; exit 1; }
      [ "$FAKE_MODE" = newprovold ] && { echo "error: the card stopped answering" >&2; exit 1; }
      touch "$keys/card-04CE.auth"; ev card-ok; printf 'XCOINMMM2\n\0\0fake' > "$file"
      [ "$FAKE_MODE" = newfile ] && { echo "error: could not seal the card: the key file could not be updated" >&2; exit 1; }   # the wallet file is written: only the last step failed
      printf '{"file": "%s", "card_uid": "04CE", "family": "fam2", "auth_file": "%s/card-04CE.auth", "passphrase_protected": true, "permanent": true}\n' "$file" "$keys";;
   esac;;
 *" commitcross "*|*" stubborn "*) hold 30; echo '{"ok": true}';;   # a run stopped by cancel, quit or timeout (the traps above say how it takes the SIGTERM)
 *" retrytest "*) ev card-wait 5; ev card-retry 1; sleep 2.5; echo '{"ok": true}';;   # the reader reset the card: the CLI waits for it again
 *" identity "*)
   [[ "$args" == *" --index 101 "* && "$args" == *" --json "* ]] || { echo "error: wrong identity call" >&2; exit 2; }
   if [ "$FAKE_MODE" = idfail ]; then echo "error: wrong passphrase" >&2; exit 1; fi
   [ "$pw" = pw ] || { echo "error: the passphrase did not arrive on stdin" >&2; exit 1; }
   printf '{"address": "txa1rx", "identity": "xid1%s", "index": 101}\n' "$(printf 'q%.0s' {1..58})";;
 *" send "*)
   [[ "$args" == *" --split "* && "$args" == *" --json "* ]] || { echo "error: wrong send call" >&2; exit 2; }
   t() { printf "$1%.0s" {1..64}; }
   ev card-wait 60; sleep 0.1; ev card-retry 1; ev card-ok
   case "$FAKE_MODE" in
    reject1) ev signing 1 1; ev broadcast-begin 1; ev rejected 1 1 insufficient-fee
      echo "error: Nothing was sent: these coins are already being spent by an earlier send that has not confirmed yet. Wait for the next block, then send again. (insufficient fee)" >&2; exit 1;;
    reject3)   # the real CLI: a later refusal is in the JSON only, raw (broadcast_error=str(BroadcastRejected)), marked broadcast_rejected
      for i in 1 2 3 4; do ev signing $i 4; done; ev broadcast-begin 4; ev broadcast 1 4 "$(t a)"; ev broadcast 2 4 "$(t b)"
      # through the explorer the node's testmempoolaccept answers first: spent coins are "missing-inputs" (xcoin-explorer.py api_broadcast)
      printf '{"broadcast": true, "txid": "%s", "txids": ["%s", "%s"], "transactions": 4, "partial": true, "amount": "10", "fee": "0.001", "vsize": 400, "broadcast_error": "broadcast rejected: missing-inputs", "broadcast_rejected": true, "unsent_txids": ["%s", "%s"]}\n' "$(t a)" "$(t a)" "$(t b)" "$(t c)" "$(t d)"; ev done;;
    rejectnode)   # the node path: its testmempoolaccept check refuses transaction 2 of 3 before anything is broadcast
      for i in 1 2 3; do ev signing $i 3; done; ev rejected 2 3 min-relay-fee-not-met
      echo "error: Nothing was sent: the node refused transaction 2 of 3, so none of the 3 was broadcast: its fee is below the network's minimum relay fee. Send again with a higher fee. (min relay fee not met, 100 < 200)" >&2; exit 1;;
    reject2plain)   # a CLI that words a later refusal itself and announces it: shown as it is
      for i in 1 2 3; do ev signing $i 3; done; ev broadcast-begin 3; ev broadcast 1 3 "$(t a)"; ev rejected 2 3 txn-mempool-conflict
      printf '{"broadcast": true, "txid": "%s", "txids": ["%s"], "transactions": 3, "partial": true, "broadcast_error": "these coins are already being spent by an earlier send that has not confirmed yet. Wait for the next block, then send again. (txn-mempool-conflict)", "broadcast_rejected": true, "unsent_txids": ["%s", "%s"]}\n' "$(t a)" "$(t a)" "$(t b)" "$(t c)"; ev done;;
    lost) ev signing 1 1; ev broadcast-begin 1
      echo "error: cannot reach the explorer at https://x.example: timed out. Nothing is confirmed sent, but if the connection dropped it may have gone out: look up $(t a) before sending again" >&2; exit 1;;
   esac;;
 *) echo "error: unexpected call $*" >&2; exit 2;;
esac
